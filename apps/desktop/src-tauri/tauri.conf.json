{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Camelia",
  "version": "0.1.0",
  "identifier": "com.camelia.desktop",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Camelia",
    "copyright": "© 2026 Camelia. Licensed under Apache-2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Warm intelligence, sharp code.",
    "longDescription": "Camelia is a task-completion-first AI coding agent. This desktop shell projects the engine's event stream into a native window.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}