{
  "name": "@camelia/core",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Camelia core — contracts, ports, event bus, task state machine, persistence, observability.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/utils/model-capabilities.d.ts",
      "import": "./dist/utils/model-capabilities.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  }
}