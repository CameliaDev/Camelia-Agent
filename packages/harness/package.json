{
  "name": "@camelia/harness",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Camelia harness — agent loop, planner, executor, verifier, context manager, tool engine, recovery.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:mcp": "vitest run test/mcp.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@camelia/core": "workspace:*"
  }
}